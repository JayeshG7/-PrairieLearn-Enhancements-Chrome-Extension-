{
    "manifest_version": 3,
    "name": "PrairieLearn Enhancements",
    "version": "1.0.0",
    "permissions": [
      "scripting", "activeTab", "tabs"
    ],
    "content_scripts": [
      {
        "matches": ["https://us.prairielearn.com/", "https://us.prairielearn.com/pl"],
        "js": ["src/content/start.js"],
        "run_at": "document_idle"
      }, 
      {
        "matches": ["https://us.prairielearn.com/pl/course_instance/*"],
        "js": ["src/content/extract_data.js"],
        "run_at": "document_idle"
      }
    ],
    "background": {
        "service_worker": "src/background/trigger.js",
        "type": "module"
    },
    "action": {}
  }